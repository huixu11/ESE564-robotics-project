<mujoco model="class_panda_basket_sorting">
  <include file="assets/Panda/panda.mjcf"/>

  <asset>
    <material name="cracker_mat" rgba="0.78 0.24 0.16 1"/>
    <material name="mustard_mat" rgba="0.95 0.76 0.12 1"/>
    <material name="cracker_marker_mat" rgba="1.0 0.0 0.0 1"/>
    <material name="mustard_marker_mat" rgba="1.0 1.0 0.0 1"/>
    <material name="left_basket_mat" rgba="0.20 0.47 0.78 0.35"/>
    <material name="right_basket_mat" rgba="0.24 0.62 0.35 0.35"/>
    <mesh name="ycb_cracker_box" file="../ycb/003_cracker_box/google_16k/textured.obj"/>
    <mesh name="ycb_mustard_bottle" file="../ycb/006_mustard_bottle/google_16k/textured.obj"/>
  </asset>

  <worldbody>
    <camera name="overhead" pos="0.35 0 1.45" xyaxes="1 0 0 0 1 0" fovy="42"/>
    <camera name="demo_view" pos="-0.1891395 -0.3910136 0.5345338" xyaxes="0.5735764 -0.819152 0 0.4340844 0.3039492 0.8480481" fovy="65"/>

    <body name="cracker_box" pos="0.35 -0.1 0.04">
      <freejoint name="cracker_box_freejoint"/>
      <geom name="cracker_box_geom" type="box" size="0.035 0.025 0.055" material="cracker_mat" mass="0.12" conaffinity="17" friction="0.25 0.005 0.0001"/>
      <geom name="cracker_box_color_marker" type="box" pos="0 0 0.058" size="0.030 0.024 0.003" material="cracker_marker_mat" contype="0" conaffinity="0" group="2"/>
      <geom name="cracker_box_visual" type="mesh" mesh="ycb_cracker_box" material="cracker_mat" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="mustard_bottle" pos="0.45 -0.1 0.046">
      <freejoint name="mustard_bottle_freejoint"/>
      <geom name="mustard_bottle_geom" type="box" size="0.030 0.030 0.045" material="mustard_mat" mass="0.15" conaffinity="17" friction="0.25 0.005 0.0001"/>
      <geom name="mustard_bottle_color_marker" type="box" pos="0 0 0.048" size="0.025 0.025 0.003" material="mustard_marker_mat" contype="0" conaffinity="0" group="2"/>
      <geom name="mustard_bottle_visual" type="mesh" mesh="ycb_mustard_bottle" material="mustard_mat" contype="0" conaffinity="0" group="2"/>
    </body>

    <body name="left_basket" pos="0.25 0.28 0.035">
      <geom name="left_basket_floor" type="box" size="0.11 0.11 0.008" material="left_basket_mat" contype="0" conaffinity="0"/>
      <geom name="left_basket_back" type="box" pos="0 0.11 0.04" size="0.11 0.006 0.045" material="left_basket_mat" contype="0" conaffinity="0"/>
      <geom name="left_basket_front" type="box" pos="0 -0.11 0.04" size="0.11 0.006 0.045" material="left_basket_mat" contype="0" conaffinity="0"/>
      <geom name="left_basket_left" type="box" pos="-0.11 0 0.04" size="0.006 0.11 0.045" material="left_basket_mat" contype="0" conaffinity="0"/>
      <geom name="left_basket_right" type="box" pos="0.11 0 0.04" size="0.006 0.11 0.045" material="left_basket_mat" contype="0" conaffinity="0"/>
    </body>

    <body name="right_basket" pos="0.55 0.28 0.035">
      <geom name="right_basket_floor" type="box" size="0.11 0.11 0.008" material="right_basket_mat" contype="0" conaffinity="0"/>
      <geom name="right_basket_back" type="box" pos="0 0.11 0.04" size="0.11 0.006 0.045" material="right_basket_mat" contype="0" conaffinity="0"/>
      <geom name="right_basket_front" type="box" pos="0 -0.11 0.04" size="0.11 0.006 0.045" material="right_basket_mat" contype="0" conaffinity="0"/>
      <geom name="right_basket_left" type="box" pos="-0.11 0 0.04" size="0.006 0.11 0.045" material="right_basket_mat" contype="0" conaffinity="0"/>
      <geom name="right_basket_right" type="box" pos="0.11 0 0.04" size="0.006 0.11 0.045" material="right_basket_mat" contype="0" conaffinity="0"/>
    </body>

    <body name="panda_contact_pusher" mocap="true" pos="0.35 0 0.40">
      <geom name="panda_contact_pusher_geom" type="box" size="0.060 0.060 0.035" material="default_material" contype="16" conaffinity="0" condim="6" friction="3.0 0.08 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    </body>

    <body name="panda_grasp_tool_target" mocap="true" pos="0.35 0 0.30">
      <site name="panda_grasp_tool_target_site" pos="0 0 0" size="0.006" rgba="0.1 0.1 0.1 1"/>
    </body>

    <body name="panda_grasp_tool" pos="0.35 0 0.30">
      <freejoint name="panda_grasp_tool_freejoint"/>
      <inertial pos="0 0 0" mass="0.12" diaginertia="0.0003 0.0003 0.0003"/>
      <site name="panda_grasp_tool_site" pos="0 0 0" size="0.006" rgba="0.1 0.1 0.1 1"/>
      <geom name="panda_grasp_top_pad_geom" type="box" pos="0 0 0.052" size="0.070 0.080 0.006" material="default_material" contype="16" conaffinity="0" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001" margin="0.004" mass="0.04" group="3"/>
      <body name="panda_grasp_left_pad" pos="0 0.085 0">
        <joint name="panda_grasp_left_slide" type="slide" axis="0 -1 0" range="0 0.070" damping="2.0"/>
        <geom name="panda_grasp_left_pad_geom" type="box" size="0.045 0.012 0.048" material="default_material" contype="16" conaffinity="0" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001" margin="0.004" mass="0.04" group="3"/>
      </body>
      <body name="panda_grasp_right_pad" pos="0 -0.085 0">
        <joint name="panda_grasp_right_slide" type="slide" axis="0 1 0" range="0 0.070" damping="2.0"/>
        <geom name="panda_grasp_right_pad_geom" type="box" size="0.045 0.012 0.048" material="default_material" contype="16" conaffinity="0" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001" margin="0.004" mass="0.04" group="3"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <adhesion name="panda_grasp_tool_adhesion" body="panda_grasp_tool" gain="150.0" ctrlrange="0 1"/>
  </actuator>

  <equality>
    <weld name="panda_grasp_tool_weld" body1="panda_grasp_tool_target" body2="panda_grasp_tool" solref="0.018 1" solimp="0.85 0.95 0.001"/>
  </equality>

  <contact>
    <pair geom1="panda_contact_pusher_geom" geom2="cracker_box_geom" condim="6" friction="3.0 0.08 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="panda_contact_pusher_geom" geom2="mustard_bottle_geom" condim="6" friction="3.0 0.08 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="panda_grasp_left_pad_geom" geom2="cracker_box_geom" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="panda_grasp_right_pad_geom" geom2="cracker_box_geom" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="panda_grasp_left_pad_geom" geom2="mustard_bottle_geom" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="panda_grasp_right_pad_geom" geom2="mustard_bottle_geom" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="panda_grasp_top_pad_geom" geom2="cracker_box_geom" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="panda_grasp_top_pad_geom" geom2="mustard_bottle_geom" condim="6" friction="5.0 0.12 0.0001" solref="0.006 1" solimp="0.85 0.95 0.001"/>
    <pair geom1="table_collision" geom2="cracker_box_geom" condim="3" friction="0.22 0.005 0.0001" solref="0.008 1" solimp="0.75 0.95 0.001"/>
    <pair geom1="table_collision" geom2="mustard_bottle_geom" condim="3" friction="0.22 0.005 0.0001" solref="0.008 1" solimp="0.75 0.95 0.001"/>
  </contact>
</mujoco>
