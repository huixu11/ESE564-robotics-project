<mujoco model="basket_sorting_panda_cartesian_standin">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.004" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.0" armature="0.01" limited="true"/>
    <geom condim="3" friction="1.0 0.05 0.005" rgba="0.7 0.7 0.7 1"/>
    <position kp="300"/>
  </default>

  <asset>
    <material name="table_mat" rgba="0.72 0.68 0.58 1"/>
    <material name="panda_white" rgba="0.86 0.86 0.82 1"/>
    <material name="panda_dark" rgba="0.12 0.13 0.14 1"/>
