      <geom name="right_basket_back" type="box" pos="0 0.11 0.04" size="0.11 0.006 0.045" material="right_basket_mat"/>
      <geom name="right_basket_front" type="box" pos="0 -0.11 0.04" size="0.11 0.006 0.045" material="right_basket_mat"/>
      <geom name="right_basket_left" type="box" pos="-0.11 0 0.04" size="0.006 0.11 0.045" material="right_basket_mat"/>
      <geom name="right_basket_right" type="box" pos="0.11 0 0.04" size="0.006 0.11 0.045" material="right_basket_mat"/>
    </body>
  </worldbody>

  <actuator>
    <position name="panda_joint1" joint="panda_joint1" kp="300" ctrlrange="-0.6 0.6"/>
    <position name="panda_joint2" joint="panda_joint2" kp="300" ctrlrange="-0.45 0.45"/>
    <position name="panda_joint3" joint="panda_joint3" kp="300" ctrlrange="0.02 0.45"/>
    <position name="panda_joint4" joint="panda_joint4" kp="80" ctrlrange="-3.0718 -0.0698"/>
    <position name="panda_joint5" joint="panda_joint5" kp="80" ctrlrange="-2.8973 2.8973"/>
    <position name="panda_joint6" joint="panda_joint6" kp="80" ctrlrange="-0.0175 3.7525"/>
    <position name="panda_joint7" joint="panda_joint7" kp="80" ctrlrange="-2.8973 2.8973"/>
    <position name="panda_finger_joint1" joint="panda_finger_joint1" kp="60" ctrlrange="0 0.04"/>
    <position name="panda_finger_joint2" joint="panda_finger_joint2" kp="60" ctrlrange="0 0.04"/>
  </actuator>
