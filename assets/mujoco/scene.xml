  </asset>

  <worldbody>
    <light name="key" pos="0 -0.6 1.5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="overhead" pos="0 0 1.45" xyaxes="1 0 0 0 1 0" fovy="42"/>
    <geom name="table" type="box" pos="0 0 -0.015" size="0.72 0.52 0.015" material="table_mat"/>

    <body name="panda_base" pos="0 0 0">
      <geom name="base_geom" type="cylinder" pos="0 -0.34 0.015" size="0.075 0.03" material="panda_dark"/>
      <body name="panda_x_axis">
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        <joint name="panda_joint1" type="slide" axis="1 0 0" range="-0.6 0.6"/>
        <body name="panda_y_axis">
          <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
          <joint name="panda_joint2" type="slide" axis="0 1 0" range="-0.45 0.45"/>
          <body name="panda_z_axis">
            <inertial pos="0 0 0" mass="0.2" diaginertia="0.002 0.002 0.002"/>
            <joint name="panda_joint3" type="slide" axis="0 0 1" range="0.02 0.45"/>
            <joint name="panda_joint4" type="hinge" axis="0 0 1" range="-3.0718 -0.0698"/>
            <joint name="panda_joint5" type="hinge" axis="1 0 0" range="-2.8973 2.8973"/>
            <joint name="panda_joint6" type="hinge" axis="0 1 0" range="-0.0175 3.7525"/>
            <joint name="panda_joint7" type="hinge" axis="1 0 0" range="-2.8973 2.8973"/>
            <geom name="vertical_column" type="capsule" fromto="0 0 0 0 0 -0.12" size="0.015" material="panda_white" contype="0" conaffinity="0"/>
