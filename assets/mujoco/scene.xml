              <site name="panda_hand_tcp" pos="0 0 0" size="0.012" rgba="1 0 0 1"/>
              <geom name="hand_geom" type="box" pos="0 0 0" size="0.035 0.025 0.018" material="panda_dark" contype="0" conaffinity="0"/>
              <body name="left_finger" pos="0 0.025 -0.025">
                <joint name="panda_finger_joint1" type="slide" axis="0 1 0" range="0 0.04"/>
                <geom type="box" size="0.008 0.006 0.035" material="panda_dark" contype="0" conaffinity="0"/>
              </body>
              <body name="right_finger" pos="0 -0.025 -0.025">
                <joint name="panda_finger_joint2" type="slide" axis="0 -1 0" range="0 0.04"/>
                <geom type="box" size="0.008 0.006 0.035" material="panda_dark" contype="0" conaffinity="0"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="cracker_box" pos="-0.12 -0.08 0.04">
      <freejoint name="cracker_box_freejoint"/>
      <geom name="cracker_box_geom" type="box" size="0.035 0.025 0.055" material="cracker_mat" mass="0.12"/>
    </body>

    <body name="mustard_bottle" pos="0.12 -0.08 0.055">
      <freejoint name="mustard_bottle_freejoint"/>
      <geom name="mustard_bottle_geom" type="cylinder" size="0.028 0.075" material="mustard_mat" mass="0.15"/>
    </body>

    <body name="left_basket" pos="-0.25 0.28 0.035">
      <geom name="left_basket_floor" type="box" size="0.11 0.11 0.008" material="left_basket_mat" contype="0" conaffinity="0"/>
      <geom name="left_basket_back" type="box" pos="0 0.11 0.04" size="0.11 0.006 0.045" material="left_basket_mat"/>
